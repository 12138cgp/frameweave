# 测试环境程序配置：复制到 deploy/runtime/test.env 后填写。test.env 不应提交。

# 管理员账号，首次启动会自动创建。
# ⚠️ ADMIN_PASSWORD 留空则【不会创建任何管理员账号】：服务照常启动、页面也打得开，
#    但没有账号能登录后台（启动日志里会有一条明确的警告）。首次部署前必须填。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# JWT 登录密钥和过期时间，正式部署请修改 JWT_SECRET。
JWT_SECRET=
JWT_EXPIRE_HOURS=168

# 后端默认监听 8080，如需本地开发修改端口再取消注释。
# Docker 镜像内前端固定监听 3000，避免覆盖前端 PORT。
PORT=8080
APP_LOG_FILE=/app/data/logs/app.log

# 公开访问地址，用于把本地上传的 Seedance 参考图/视频暴露给火山方舟拉取。
# 正式部署时填写站点根地址，例如：https://your-domain.example.com
PUBLIC_BASE_URL=http://your-server-ip:3001

# 火山方舟「私域人像素材资产库」配置（用于 Seedance 2.0 真人风格视频的人像资产认证）。
# 鉴权使用火山引擎 IAM 的 AK/SK（需要 ark:*Asset* 权限），不是上面的生图 API Key。
# VOLC_ASSET_PROJECT_NAME 必须与调用视频生成的 API Key 所属项目一致，否则素材入库后取不到。
# 注意：CreateAsset 由火山主动拉取图片 URL，本地 localhost 火山访问不到，需配好 PUBLIC_BASE_URL 并部署到公网后才能真正入库。
# VOLC_ACCESS_KEY=
# VOLC_SECRET_KEY=
# VOLC_ASSET_PROJECT_NAME=default
# VOLC_ASSET_REGION=cn-beijing
# VOLC_ASSET_GROUP_NAME=aicanvas-portraits

# 前端开发代理默认使用 http://127.0.0.1:8080，如后端开发端口不同，启动前端时可单独设置 API_BASE_URL。
# Docker 部署时前端容器通过 Docker DNS 访问后端，不要填宿主机 localhost。
API_BASE_URL=http://backend:8080
PROXY_MAX_UPLOAD_MB=300

# 数据库配置，当前部署使用独立 PostgreSQL。
STORAGE_DRIVER=postgres
# postgres 目标库不存在时会尝试自动创建，账号需有 CREATEDB 权限。
# postgres: DATABASE_DSN=postgres://user:password@127.0.0.1:5432/aicanvas?sslmode=disable
DATABASE_DSN=

# 测试环境业务凭据按需填写，禁止复用正式环境密钥。
# TOS_BUCKET=
# TOS_REGION=cn-beijing
# TOS_ENDPOINT=tos-s3-cn-beijing.volces.com
# TOS_ACCESS_KEY=
# TOS_SECRET_KEY=
# TOS_PUBLIC_BASE=

# 多图图生图的图片字段白名单（逗号分隔的上游域名片段，大小写不敏感）。
# 少数 OpenAI 兼容中转站的多图编辑要求 image[] 数组语法，发重复的 image 字段会被上游
# 400 顶回（Duplicate parameter: 'image'）；多数站正相反，必须收重复的 image。
# 留空=不改写（默认，保持官方语义）。接入的中转站报上述 400 时，把它的域名片段填进来重启即可。
# GPT_IMAGE_ARRAY_FIELD_HOSTS=relay-a.example.com,relay-b.example.cn

# 可信反向代理。留空时默认信任「回环 + 私有网段」，标准的
# 「Nginx 置前 + 前后端分容器」部署开箱即用。支持精确 IP 与 CIDR 网段，逗号分隔。
# 不配且默认值又被收紧时，全站用户的客户端 IP 会塌缩成前端容器的 IP：
# 登录失败锁定按「用户名 + IP」计数，IP 一相同，任何人知道别人用户名就能锁死该账号。
TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1,::1

# 后端同时处理的生成任务数。出厂 16；排队久可调大，上游限流严时调小。改完重启后端生效。
# GENERATION_JOB_CONCURRENCY=16
