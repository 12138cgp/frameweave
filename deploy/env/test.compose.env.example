# 测试环境 Compose/部署参数：复制到 deploy/compose/test.env 后填写。test.env 不应提交。
COMPOSE_PROJECT_NAME=frameweave-test
DEPLOY_ENV=test
NETWORK_NAME=frameweave_test_net

# 应用文件目录，出厂默认值，可改成你服务器上的任意路径。
APP_DATA_DIR=/data/frameweave/test/app-data
# 只监听本机，外部访问一律经 Nginx 反代。
# 写成裸端口会绑到 0.0.0.0，等于把服务直接暴露在公网、绕过 HTTPS。
FRONTEND_PORT=127.0.0.1:3001

# 镜像仓库名；发布标签由 deploy.sh 自动生成并记录在 runtime/releases/test.env。
BACKEND_IMAGE_REPO=frameweave-backend
FRONTEND_IMAGE_REPO=frameweave-frontend
