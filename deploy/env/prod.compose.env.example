# 正式环境 Compose/部署参数：复制到 deploy/compose/prod.env 后填写。prod.env 不应提交。
COMPOSE_PROJECT_NAME=frameweave-prod
DEPLOY_ENV=prod
NETWORK_NAME=frameweave_prod_net

# 应用文件目录（图片/视频/日志都落在这里），会被挂载到容器 /app/data。
# 下面是出厂默认值，可改成你服务器上的任意路径；
# 换目录前先把原目录整份搬过去，这里存着用户生成的全部内容。
APP_DATA_DIR=/data/frameweave/prod/app-data
# 只监听本机，外部访问一律经 Nginx 反代。
# 写成裸端口会绑到 0.0.0.0，等于把服务直接暴露在公网、绕过 HTTPS。
FRONTEND_PORT=127.0.0.1:3000

# 镜像仓库名；发布标签由 deploy.sh 自动生成并记录在 runtime/releases/prod.env。
BACKEND_IMAGE_REPO=frameweave-backend
FRONTEND_IMAGE_REPO=frameweave-frontend
